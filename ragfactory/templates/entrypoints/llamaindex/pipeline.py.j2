async def run_pipeline_async(
    query: str, return_contexts: bool = False
) -> str | tuple[str, list[str]]:
    """Run the full {{ pipeline_name }} RAG pipeline.

    Args:
        query: The user question to answer.
        return_contexts: Whether to return the retrieved context nodes alongside the answer.

    Returns:
        The generated answer string, or (answer, contexts) if return_contexts is True.
    """
    # Configure LlamaIndex global settings
    Settings.embed_model = build_embedding()
    Settings.llm         = build_llm()

    vectorstore = build_vectordb(Settings.embed_model)
    retriever   = build_retrieval(vectorstore)

    node_postprocessors: list = []
{% if stages.reranker is defined and stages.reranker %}
    node_postprocessors.append(build_reranker())
{% endif %}
{% if config.retrieval.type == "sentence_window" %}
    # ── Sentence Window: replace retrieved sentence nodes with surrounding context
    node_postprocessors.append(build_sentence_window_postprocessor())
{% endif %}

{% if pre_retrieval.query_rewriting is not none and pre_retrieval.query_rewriting.enabled %}
    # ── Query Rewriting ({{ pre_retrieval.query_rewriting.strategy }},
    #    {{ pre_retrieval.query_rewriting.num_rewrites }} variants) ────────────
    from llama_index.core.query_engine import TransformQueryEngine
    from llama_index.core.indices.query.query_transform.base import HyDEQueryTransform
    # Use QueryFusionRetriever for multi-query expansion
    from llama_index.core.retrievers import QueryFusionRetriever
    retriever = QueryFusionRetriever(
        [retriever],
        llm=Settings.llm,
        num_queries={{ pre_retrieval.query_rewriting.num_rewrites }},
        mode="reciprocal_rerank",
    )
{% endif %}
{% if pre_retrieval.hyde is not none and pre_retrieval.hyde.enabled %}
    # ── HyDE — Hypothetical Document Embeddings ───────────────────────────────
    from llama_index.core.indices.query.query_transform.base import HyDEQueryTransform
    _hyde_transform = HyDEQueryTransform(include_original=True)
{% endif %}

    query_engine = RetrieverQueryEngine(
        retriever=retriever,
        node_postprocessors=node_postprocessors,
        response_synthesizer=get_response_synthesizer(
            text_qa_template=PromptTemplate(
                _PROMPT_TEMPLATE,
                template_var_mappings={"context_str": "context", "query_str": "question"},
            ),
        ),
    )

{% if pre_retrieval.hyde is not none and pre_retrieval.hyde.enabled %}
    from llama_index.core.query_engine import TransformQueryEngine
    query_engine = TransformQueryEngine(query_engine, query_transform=_hyde_transform)
{% endif %}

    response = await query_engine.aquery(query)
    if return_contexts:
        contexts = [node.node.get_content() for node in response.source_nodes]
        return str(response), contexts
    return str(response)


def run_pipeline(query: str, return_contexts: bool = False) -> str | tuple[str, list[str]]:
    """Synchronously run the pipeline; use run_pipeline_async from async code."""
    import asyncio

    return asyncio.run(run_pipeline_async(query, return_contexts))
