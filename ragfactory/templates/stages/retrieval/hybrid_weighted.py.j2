# Weighted hybrid: LangChain weighted RRF; LlamaIndex relative-score fusion.
{% if framework == "langchain" %}
import json
from pathlib import Path
from langchain_classic.retrievers import EnsembleRetriever
from langchain_community.retrievers import BM25Retriever
from langchain_core.documents import Document
{% elif framework == "llamaindex" %}
from llama_index.core import VectorStoreIndex, StorageContext
from llama_index.core.vector_stores.types import VectorStoreQueryMode
{% endif %}

def build_retrieval(vectorstore: Any) -> Any:
{% if framework == "langchain" %}
    dense_retriever = vectorstore.as_retriever(search_kwargs={"k": {{ retrieval.top_k }}})
    corpus_path = Path(__file__).with_name("chunks.json")
    if not corpus_path.is_file():
        raise FileNotFoundError(f"BM25 corpus not found: {corpus_path}; run ingestion.py first")
    with corpus_path.open(encoding="utf-8") as corpus_file:
        records = json.load(corpus_file)
    if not isinstance(records, list) or not records:
        raise ValueError(f"BM25 corpus is empty or malformed: {corpus_path}")
    documents = [
        Document(page_content=record["page_content"], metadata=record.get("metadata", {}))
        for record in records
    ]
    sparse_retriever = BM25Retriever.from_documents(
        documents,
        k={{ retrieval.top_k }},
        bm25_params={"k1": {{ retrieval.bm25_k1 }}, "b": {{ retrieval.bm25_b }}},
    )
    return EnsembleRetriever(
        retrievers=[sparse_retriever, dense_retriever],
        weights=[{{ 1.0 - retrieval.alpha }}, {{ retrieval.alpha }}],
        c=60,
    )
{% elif framework == "llamaindex" %}
{% if vector_db_type == "qdrant" %}
    storage_context = StorageContext.from_defaults(vector_store=vectorstore)
    index = VectorStoreIndex.from_vector_store(vectorstore, storage_context=storage_context)
    return index.as_retriever(
        vector_store_query_mode=VectorStoreQueryMode.HYBRID,
        similarity_top_k={{ retrieval.top_k }},
        alpha={{ retrieval.alpha }},
    )
{% else %}
    raise NotImplementedError(
        "LlamaIndex hybrid retrieval is only configured for Qdrant; "
        "select Qdrant or use dense retrieval"
    )
{% endif %}
{% endif %}
