{% if framework == "langchain" %}
import os
from langchain_milvus import Milvus
{% elif framework == "llamaindex" %}
import os
from llama_index.vector_stores.milvus import MilvusVectorStore
{% endif %}

def build_vectordb(embedder: Any) -> Any:
{% if framework == "langchain" %}
    return Milvus(
        embedding_function=embedder,
        collection_name={{ vector_db.collection_name | to_py_literal }},
        connection_args={"uri": os.environ.get("MILVUS_URI", {{ vector_db.uri | to_py_literal }})},
    )
{% elif framework == "llamaindex" %}
    return MilvusVectorStore(
        uri=os.environ.get("MILVUS_URI", {{ vector_db.uri | to_py_literal }}),
        collection_name={{ vector_db.collection_name | to_py_literal }},
        dim={{ embedding_dim }},
    )
{% endif %}
