from __future__ import annotations

import asyncio
import json
import math
import sys
from pathlib import Path
from typing import Any

from dotenv import load_dotenv
from pipeline import run_pipeline

load_dotenv()

_METRIC_NAMES = {{ evaluation.metrics | tojson_py }}
_JUDGE_MODEL = {{ evaluation.judge_model | tojson_py }}
_PASS_THRESHOLD = {{ evaluation.pass_threshold }}
_NUM_TEST_CASES = {{ evaluation.num_test_cases }}


def load_test_cases() -> list[dict[str, str]]:
    dataset_path = Path("eval_dataset.json")
    if not dataset_path.exists():
        return [{"question": "What is the name of this pipeline?", "ground_truth": "{{ pipeline_name }}"}]

    try:
        data = json.loads(dataset_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise ValueError(f"Cannot read {dataset_path}: {exc}") from exc
    if not isinstance(data, list) or not data:
        raise ValueError(f"{dataset_path} must contain a non-empty JSON array")

    cases: list[dict[str, str]] = []
    for index, case in enumerate(data):
        if not isinstance(case, dict) or not isinstance(case.get("question"), str) or not case["question"].strip():
            raise ValueError(f"{dataset_path} item {index} must have a non-empty string 'question'")
        ground_truth = case.get("ground_truth", "")
        if not isinstance(ground_truth, str):
            raise ValueError(f"{dataset_path} item {index} field 'ground_truth' must be a string")
        if "context_precision" in _METRIC_NAMES and not ground_truth.strip():
            raise ValueError(
                f"{dataset_path} item {index} needs a non-empty 'ground_truth' for context_precision"
            )
        cases.append({"question": case["question"], "ground_truth": ground_truth})
    return cases[:_NUM_TEST_CASES]


def score_passes(metric_name: str, score: Any) -> bool:
    try:
        value = float(score)
    except (TypeError, ValueError):
        value = math.nan
    if not math.isfinite(value):
        print(f"FAIL: Metric '{metric_name}' returned a non-finite or invalid score: {score!r}")
        return False
    if value < _PASS_THRESHOLD:
        print(f"FAIL: Metric '{metric_name}' score {value:.2f} is below threshold {_PASS_THRESHOLD}")
        return False
    print(f"PASS: Metric '{metric_name}' score {value:.2f}")
    return True


def _run_ragas(results: list[dict[str, Any]]) -> bool:
    from openai import AsyncOpenAI
    from ragas.embeddings.base import embedding_factory
    from ragas.llms import llm_factory
    from ragas.metrics.collections import AnswerRelevancy, ContextPrecision, Faithfulness

    # Ragas 0.4 forces temperature=1; Luna permits sampling settings with reasoning disabled.
    judge_options = {"reasoning_effort": "none"} if _JUDGE_MODEL == "gpt-6-luna" else {}
    judge = llm_factory(_JUDGE_MODEL, client=AsyncOpenAI(), **judge_options)
    relevancy_embeddings = embedding_factory(
        "openai", model="text-embedding-3-small", client=AsyncOpenAI()
    )
    metric_types = {
        "faithfulness": Faithfulness,
        "answer_relevancy": AnswerRelevancy,
        "context_precision": ContextPrecision,
    }
    metrics = []
    for name in _METRIC_NAMES:
        if name == "answer_relevancy":
            metric = AnswerRelevancy(llm=judge, embeddings=relevancy_embeddings)
        else:
            metric = metric_types[name](llm=judge)
        metrics.append((name, metric))

    async def score_all() -> bool:
        passed = True
        for result in results:
            for name, metric in metrics:
                inputs = {
                    "user_input": result["question"],
                    "response": result["answer"],
                }
                if name in {"faithfulness", "context_precision"}:
                    inputs["retrieved_contexts"] = result["contexts"]
                if name == "context_precision":
                    inputs["reference"] = result["ground_truth"]
                score_result = await metric.ascore(**inputs)
                passed = score_passes(name, score_result.value) and passed
        return passed

    print("\n--- Running Ragas Evaluation ---")
    return asyncio.run(score_all())


def _run_deepeval(results: list[dict[str, Any]]) -> bool:
    from deepeval.metrics import AnswerRelevancyMetric, FaithfulnessMetric, ContextualPrecisionMetric
    from deepeval.test_case import LLMTestCase

    metric_types = {
        "faithfulness": FaithfulnessMetric,
        "answer_relevancy": AnswerRelevancyMetric,
        "context_precision": ContextualPrecisionMetric,
    }
    metrics = [
        metric_types[name](threshold=_PASS_THRESHOLD, model=_JUDGE_MODEL)
        for name in _METRIC_NAMES
    ]
    print("\n--- Running DeepEval Evaluation ---")
    passed = True
    for result in results:
        case = LLMTestCase(
            input=result["question"],
            actual_output=result["answer"],
            expected_output=result["ground_truth"],
            retrieval_context=result["contexts"],
        )
        for metric in metrics:
            metric.measure(case)
            metric_name = metric.__class__.__name__
            passed = score_passes(metric_name, metric.score) and passed
            if not metric.is_successful():
                passed = False
    return passed


def run_evaluation() -> None:
    test_cases = load_test_cases()
    print(f"Running pipeline for {len(test_cases)} test cases...")
    results = []
    for case in test_cases:
        answer, contexts = run_pipeline(case["question"], return_contexts=True)
        results.append({
            "question": case["question"],
            "answer": answer,
            "contexts": contexts,
            "ground_truth": case["ground_truth"],
        })

    passed = True
{% if evaluation.framework == "ragas" or evaluation.framework == "both" %}
    passed = _run_ragas(results) and passed
{% endif %}
{% if evaluation.framework == "deepeval" or evaluation.framework == "both" %}
    passed = _run_deepeval(results) and passed
{% endif %}
    if passed:
        print("\nSUCCESS: All evaluation metrics passed threshold verification.")
        sys.exit(0)
    print("\nFAILURE: Evaluation metrics failed threshold verification.")
    sys.exit(1)


if __name__ == "__main__":
    run_evaluation()
